# RiskAI environment config
# Copy this file to .env and fill in your values

# ── Local development ────────────────────────────────────────────
# Path to your Firebase service-account JSON key (local only)
FIREBASE_CREDENTIALS=../Backend/serviceAccountKey.json

# ── Render / Production deployment ──────────────────────────────
# Paste the FULL contents of your serviceAccountKey.json as a single-line JSON string
# (set this in the Render dashboard under Environment Variables)
FIREBASE_CREDENTIALS_JSON=

# ── Chit group config ────────────────────────────────────────────
GROUP_ID=GRP-001
GROUP_NAME=Sunrise Chit Fund
MONTHLY_CONTRIBUTION=5000
CHIT_VALUE=100000
GROUP_START_DATE=2024-01-01
TOTAL_CYCLES=20
